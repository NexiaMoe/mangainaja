# Environment Variables for MangainAja
# Copy this file to .env.local and fill in your values

# GraphQL API Endpoint
# Contact the project maintainer for access to the GraphQL API
NEXT_PUBLIC_GRAPHQL_ENDPOINT=YOUR_GRAPHQL_ENDPOINT_HERE

# Example format:
# NEXT_PUBLIC_GRAPHQL_ENDPOINT=https://your-api-domain.com/graphql/

# Note: This project requires a compatible manga GraphQL API
# The API should support the following queries:
# - get_content_searchComic
# - get_content_comicNode  
# - get_content_chapterList
# - get_content_chapterNode